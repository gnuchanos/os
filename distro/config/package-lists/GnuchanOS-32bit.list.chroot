# GnuchanOS 32-bit - the packages the live image carries.
# This is for 32-bit builds using AntiX repositories

# --- a bootable live system ---
live-boot
live-config
live-config-systemd
systemd
systemd-sysv
dbus

# --- the boot splash ---
plymouth
plymouth-themes
initramfs-tools
zstd

# --- GRUB for 32-bit ---
grub-common
grub2-common
grub-pc-bin
# For 32-bit UEFI (IA32)
grub-efi-ia32-bin

# --- disk tools ---
parted
gdisk
btrfs-progs
zram-tools
xfsprogs
f2fs-tools
dosfstools
efibootmgr
cryptsetup

# --- the X server's own parts ---
xkb-data
x11-xkb-utils
x11-utils
x11-xserver-utils
xauth
xinit
keyboard-configuration
libinput10
xserver-xorg-input-libinput
xinput
libinput-tools
udev
libgl1
libgl1-mesa-dri
libegl1
libgbm1
procps
pciutils
usbutils

# --- fonts ---
xfonts-base
fonts-dejavu-core
fonts-dejavu-extra
fonts-liberation2

# --- the tools the Gnuchan programs are built with ---
build-essential
pkg-config
python3
python3-setuptools
ca-certificates
curl
gnupg
git
rsync

